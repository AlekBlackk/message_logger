API_ID=
API_HASH=
SESSION_NAME=logger

# One-time seed only: imported into the database on first run if the
# database's watch list is still empty, then no longer read — manage the
# watch list afterwards with /watch, /unwatch, /list sent to LOG_TARGET.
# Empty = watch every chat.
WATCH_CHATS=
IGNORE_CHATS=

LOG_TARGET=me
LOG_OUTGOING=true
LOG_EDITS=true
LOG_JOINS=true

DOWNLOAD_MEDIA=true
MAX_MEDIA_MB=50
# Total size cap for everything under MEDIA_DIR. 0 disables it. Over the cap,
# the oldest downloaded media is evicted (file deleted, DB row kept without it)
MAX_MEDIA_TOTAL_MB=0
MEDIA_DIR=media

DB_PATH=messages.db
RETENTION_DAYS=14

# Backfill runs only when WATCH_CHATS is a non-empty explicit list
BACKFILL_ON_START=true
BACKFILL_LIMIT=200

# DEBUG/INFO/WARNING/ERROR/CRITICAL. Empty LOG_FILE = console only
LOG_LEVEL=INFO
LOG_FILE=

# Periodic check that cached messages still exist, catching deletions the
# update stream never delivered. 0 disables it
RECONCILE_INTERVAL_MIN=10
RECONCILE_WINDOW_HOURS=12

PROXY_ENABLED=false
PROXY_TYPE=socks5
PROXY_HOST=127.0.0.1
PROXY_PORT=10808
