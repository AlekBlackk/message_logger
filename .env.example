API_ID=
API_HASH=
SESSION_NAME=logger

# Empty = watch every chat. Otherwise comma-separated ids or @usernames
WATCH_CHATS=
IGNORE_CHATS=

LOG_TARGET=me
LOG_OUTGOING=true
LOG_EDITS=true

DOWNLOAD_MEDIA=true
MAX_MEDIA_MB=50
MEDIA_DIR=media

DB_PATH=messages.db
RETENTION_DAYS=14

# Backfill runs only when WATCH_CHATS is a non-empty explicit list
BACKFILL_ON_START=true
BACKFILL_LIMIT=200

PROXY_ENABLED=false
PROXY_TYPE=socks5
PROXY_HOST=127.0.0.1
PROXY_PORT=10808
